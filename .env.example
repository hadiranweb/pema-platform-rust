# PEMA Platform Configuration Template
# Copy this file to .env and update the values

# Core Platform Settings
PLATFORM_HOST=0.0.0.0
PLATFORM_PORT=8080
DOMAIN=your-domain.com
BASE_URL=https://your-domain.com

# Database Configuration
DATABASE_URL=postgres://pema_user:your_secure_database_password@localhost:5432/pema_db
DB_POOL_SIZE=10

# Application Configuration
APP_NAME="PEMA Platform"
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=info

# Security Configuration
JWT_SECRET=your_secure_jwt_secret_here_replace_in_production
SESSION_TIMEOUT=3600
CORS_ORIGINS=https://your-domain.com

# Plugin Configuration
PLUGIN_DIR=./plugins
WASM_PLUGIN_DIR=./wasm-plugins

# SQLx Configuration
SQLX_OFFLINE=true

# Rust Configuration
RUST_LOG=info

