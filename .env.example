# PEMA Platform Environment Configuration
# کپی این فایل به .env و مقادیر را تنظیم کنید

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
DATABASE_NAME=pema
DATABASE_USER=postgres
DATABASE_PASSWORD=secure_password_123_change_in_production
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_URL=postgresql://${DATABASE_USER}:${DATABASE_PASSWORD}@${DATABASE_HOST}:${DATABASE_PORT}/${DATABASE_NAME}

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================
BACKEND_PORT=8080
AUTH_PORT=8081
SERVER_HOST=0.0.0.0
RUST_LOG=info

# =============================================================================
# JWT CONFIGURATION
# =============================================================================
JWT_SECRET=super_secure_jwt_secret_key_change_in_production_minimum_32_chars
JWT_EXPIRATION_HOURS=24

# =============================================================================
# REDIS CONFIGURATION
# =============================================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis_password_123_change_in_production

# =============================================================================
# EMAIL CONFIGURATION
# =============================================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# =============================================================================
# SMS CONFIGURATION
# =============================================================================
SMS_PROVIDER=kavenegar
SMS_API_KEY=your-sms-api-key
OTP_EXPIRATION_MINUTES=5

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
RATE_LIMIT_REQUESTS=100
BCRYPT_COST=12

