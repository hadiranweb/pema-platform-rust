# Server Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
DOMAIN=localhost
BASE_URL=http://localhost:8080

# Database Configuration (PostgreSQL example)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=pema_db
DB_USER=pema_user
DB_PASSWORD=pema_password
DB_POOL_SIZE=10

# Application Configuration
APP_NAME="PEMA Platform"
ENVIRONMENT=development # development, production, testing
DEBUG=true
LOG_LEVEL=info # trace, debug, info, warn, error

# Security Configuration
JWT_SECRET="your_super_secret_jwt_key_at_least_32_chars"
SESSION_TIMEOUT=3600 # seconds
CORS_ORIGINS="*" # comma-separated list of allowed origins, e.g., "http://localhost:3000,https://yourdomain.com"

# Path to config.toml (optional, defaults to config.toml in current directory)
# CONFIG_PATH=./config.toml

