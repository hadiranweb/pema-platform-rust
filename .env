SERVER_HOST=127.0.0.1
SERVER_PORT=8080
DOMAIN=pemalune.ir
BASE_URL=https://pemalune.ir

# Database Configuration (PostgreSQL example)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=pema_db
DB_USER=pema_user
DB_PASSWORD="your_secure_database_password"
DB_POOL_SIZE=10

# Application Configuration
APP_NAME="PEMA Platform"
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=info

# Security Configuration
JWT_SECRET="a_very_long_and_secure_jwt_secret_key_for_pemalune_ir"
SESSION_TIMEOUT=3600
CORS_ORIGINS="https://pemalune.ir"

DATABASE_URL=postgres://pema_user:your_secure_database_password@127.0.0.1:5432/pema_db

